# Streamlit Cloud / Local Secrets Configuration Template
# For local development: copy this file to .streamlit/secrets.toml
# For Streamlit Cloud: paste these keys into App Settings -> Secrets

# Option 1 (Recommended for Streamlit Cloud):
# Direct download URL for creditcard.csv (or a .zip archive containing creditcard.csv)
# Examples: GitHub Releases asset, Hugging Face dataset, AWS S3, Google Drive, Dropbox
# DATASET_URL = "https://github.com/<owner>/<repo>/releases/download/v1.0.0/creditcard.csv"

# Option 2 (Custom / Mounted Path):
# Filesystem path to creditcard.csv if mounted or placed outside the repository root
# DATASET_PATH = "dataset/creditcard.csv"

# Optional: Remote URL or custom path for the Local Outlier Factor model (118 MB)
# LOF_URL = "https://github.com/<owner>/<repo>/releases/download/v1.0.0/lof.pkl"
# LOF_PATH = "models/lof.pkl"
